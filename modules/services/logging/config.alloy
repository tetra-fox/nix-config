// HOSTNAME, LOKI_HOST and LOKI_PORT come from the nixos module's environment so this
// file stays plain alloy that `alloy fmt` can parse

// oci-containers run as podman-<name>.service, so the journal covers them too
loki.source.journal "journald" {
	max_age       = "12h"
	relabel_rules = loki.relabel.journald.rules
	forward_to    = [loki.write.local.receiver]
	labels        = {
		job  = "systemd-journal",
		host = sys.env("HOSTNAME"),
	}
}

loki.relabel "journald" {
	// only used for its rules, but alloy requires forward_to
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.write "local" {
	endpoint {
		url = "http://" + sys.env("LOKI_HOST") + ":" + sys.env("LOKI_PORT") + "/loki/api/v1/push"
	}
}
